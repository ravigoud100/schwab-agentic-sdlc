{
  "api_contracts": [
    {
      "id": "api-create",
      "method": "POST",
      "path": "/api/urls",
      "request_fields": [
        {
          "name": "expiresAt",
          "type": "UTC_timestamp",
          "required": false
        }
      ],
      "validation_rules": [
        {
          "field": "expiresAt",
          "predicate": "strictly_after_now",
          "otherwise": "rejected"
        }
      ],
      "response_behavior": [
        "accepted: Returns the short code and short URL.",
        "rejected: Returns HTTP 400 Bad Request if expiresAt is provided and not in the future.",
        "missing: Returns the short code and short URL if expiresAt is not provided."
      ]
    }
  ],
  "components": [
    {
      "id": "service",
      "path": "url-shortener/src/main/java/url_shortener/UrlService.java",
      "responsibility": "Provides business logic for creating and retrieving short URLs."
    },
    {
      "id": "controller",
      "path": "url-shortener/src/main/java/url_shortener/UrlController.java",
      "responsibility": "Handles the API requests for creating and retrieving short URLs."
    },
    {
      "id": "repository",
      "path": "url-shortener/src/main/java/url_shortener/UrlRepository.java",
      "responsibility": "Provides data access for the ShortUrl entity."
    },
    {
      "id": "tests",
      "path": "url-shortener/src/test/java/url_shortener/UrlExpirationIntegrationTests.java",
      "responsibility": "Approved test cases for URL expiration."
    }
  ],
  "interactions": [
    {
      "from": "controller",
      "to": "service",
      "operation": "createShortUrl"
    },
    {
      "from": "service",
      "to": "repository",
      "operation": "saveShortUrl"
    },
    {
      "from": "service",
      "to": "repository",
      "operation": "findShortUrlByCode"
    }
  ],
  "data_model_changes": [],
  "compatibility_risks": [
    {
      "id": "risk-1",
      "description": "The new requirement introduces a new configuration decision that has not been approved yet. This could lead to delays in implementing the feature.",
      "mitigation": "Ensure the new requirement is approved before proceeding with implementation."
    },
    {
      "id": "risk-2",
      "description": "If the expiration time is provided and is not in the future, the current implementation returns HTTP 400 Bad Request. This could be confusing for users who expect the URL to be created even if the expiration time is in the past.",
      "mitigation": "Update the documentation to clarify the behavior and provide guidance on how to handle past expiration times."
    }
  ],
  "architectural_decisions": [
    {
      "id": "decision-1",
      "decision": "Custom expiration timestamp",
      "rationale": "The caller should provide a future UTC expiration timestamp for the short URL."
    }
  ],
  "coverage": [
    {
      "obligation_id": "caller-expiration",
      "kind": "implementation",
      "spec": {
        "operation": "accept_optional_input",
        "field": "expiresAt",
        "source": "caller",
        "representation": "UTC_timestamp"
      },
      "component_ids": ["controller"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "future-only",
      "kind": "implementation",
      "spec": {
        "operation": "validate",
        "field": "expiresAt",
        "predicate": "strictly_after_now",
        "otherwise": "rejected"
      },
      "component_ids": ["service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "utc-consistency",
      "kind": "implementation",
      "spec": {
        "operation": "compare_and_store",
        "field": "expiresAt",
        "time_basis": "UTC"
      },
      "component_ids": ["service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "missing-compatibility",
      "kind": "implementation",
      "spec": {
        "operation": "preserve",
        "when": "expiresAt_missing",
        "behavior": "no_expiration_existing_links_and_redirects"
      },
      "component_ids": ["service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "test-future",
      "kind": "test",
      "spec": {
        "input_expiresAt": "now_plus_1_hour",
        "clock": "fixed_UTC",
        "expected": "accepted"
      },
      "component_ids": ["tests"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "test-past",
      "kind": "test",
      "spec": {
        "input_expiresAt": "now_minus_1_hour",
        "clock": "fixed_UTC",
        "expected": "rejected"
      },
      "component_ids": ["tests"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "test-boundary",
      "kind": "test",
      "spec": {
        "input_expiresAt": "now",
        "clock": "fixed_UTC",
        "expected": "rejected"
      },
      "component_ids": ["tests"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "test-missing",
      "kind": "test",
      "spec": {
        "input_expiresAt": null,
        "clock": "fixed_UTC",
        "expected": "no_expiration"
      },
      "component_ids": ["tests"],
      "decision_ids": ["decision-1"]
    }
  ]
}