{
  "api_contracts": [
    {
      "id": "api-create",
      "method": "POST",
      "path": "/api/urls",
      "request_fields": [
        {
          "name": "expiresAt",
          "type": "UTC timestamp",
          "required": false
        }
      ],
      "response_behavior": [
        "If 'expiresAt' is provided and is in the future, the response is the short code and short URL. If 'expiresAt' is provided and is not in the future, the response is HTTP 400 Bad Request. If 'expiresAt' is missing, the response is the short code and short URL with no expiration."
      ]
    }
  ],
  "components": [
    {
      "id": "url-service",
      "path": "url-shortener/src/main/java/url_shortener/UrlService.java",
      "responsibility": "Provides business logic for creating and retrieving short URLs, including handling expiration times."
    },
    {
      "id": "url-controller",
      "path": "url-shortener/src/main/java/url_shortener/UrlController.java",
      "responsibility": "Handles API requests for creating and retrieving short URLs, invoking the UrlService."
    },
    {
      "id": "url-repository",
      "path": "url-shortener/src/main/java/url_shortener/UrlRepository.java",
      "responsibility": "Provides data access for the ShortUrl entity."
    },
    {
      "id": "redirect-controller",
      "path": "url-shortener/src/main/java/url_shortener/RedirectController.java",
      "responsibility": "Handles redirect requests, invoking the UrlService to retrieve the original URL."
    }
  ],
  "interactions": [
    {
      "from": "url-controller",
      "to": "url-service",
      "operation": "createShortUrl"
    },
    {
      "from": "redirect-controller",
      "to": "url-service",
      "operation": "getOriginalUrl"
    }
  ],
  "data_model_changes": [
    {
      "component_id": "short-url",
      "field": "expiresAt",
      "change": "Retained semantics with new validation and storage requirements."
    }
  ],
  "compatibility_risks": [
    {
      "id": "risk-1",
      "description": "If the expiration time is provided and is not in the future, the current implementation returns HTTP 400 Bad Request. This could be confusing for users who expect the URL to be created even if the expiration time is in the past.",
      "mitigation": "The new requirement specifies that if 'expiresAt' is provided and is not in the future, the response should be HTTP 400 Bad Request. This behavior is consistent with the existing implementation."
    }
  ],
  "architectural_decisions": [
    {
      "id": "decision-1",
      "decision": "Custom expiration timestamp",
      "rationale": "The decision to allow custom expiration timestamps was approved to provide more flexibility in URL management."
    }
  ],
  "coverage": [
    {
      "obligation_id": "caller-expiration",
      "kind": "implementation",
      "spec": {
        "operation": "accept_optional_input",
        "field": "expiresAt",
        "source": "caller",
        "representation": "UTC_timestamp"
      },
      "component_ids": ["url-service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "future-only",
      "kind": "implementation",
      "spec": {
        "operation": "validate",
        "field": "expiresAt",
        "predicate": "strictly_after_now",
        "otherwise": "rejected"
      },
      "component_ids": ["url-service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "utc-consistency",
      "kind": "implementation",
      "spec": {
        "operation": "compare_and_store",
        "field": "expiresAt",
        "time_basis": "UTC"
      },
      "component_ids": ["url-service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "missing-compatibility",
      "kind": "implementation",
      "spec": {
        "operation": "preserve",
        "when": "expiresAt_missing",
        "behavior": "no_expiration_existing_links_and_redirects"
      },
      "component_ids": ["url-service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "test-future",
      "kind": "test",
      "spec": {
        "input_expiresAt": "now_plus_1_hour",
        "clock": "fixed_UTC",
        "expected": "accepted"
      },
      "component_ids": ["url-service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "test-past",
      "kind": "test",
      "spec": {
        "input_expiresAt": "now_minus_1_hour",
        "clock": "fixed_UTC",
        "expected": "rejected"
      },
      "component_ids": ["url-service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "test-boundary",
      "kind": "test",
      "spec": {
        "input_expiresAt": "now",
        "clock": "fixed_UTC",
        "expected": "rejected"
      },
      "component_ids": ["url-service"],
      "decision_ids": ["decision-1"]
    },
    {
      "obligation_id": "test-missing",
      "kind": "test",
      "spec": {
        "input_expiresAt": null,
        "clock": "fixed_UTC",
        "expected": "no_expiration"
      },
      "component_ids": ["url-service"],
      "decision_ids": ["decision-1"]
    }
  ]
}